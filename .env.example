# Set this in your shell before building the editor checks.
# The application does not load .env files.
FACEPUNCH_ENGINE=/path/to/sbox

# Optional in-editor processing host; see docs/editor-host.md.
# Set a random 32-256 character secret, shared only with your provider website.
# MOCAP_KEY_SECRET=
# MOCAP_API_KEYS={"operator":"a-random-key-of-at-least-32-characters"}
MOCAP_PORT=5080
MOCAP_MAX_UPLOAD_MB=512
MOCAP_MAX_CLIP_SECONDS=60
MOCAP_MAX_JOBS_PER_USER=2
MOCAP_CONCURRENT_JOBS=1
MOCAP_LANES=0
# MOCAP_CACHE_DIRECTORY=/path/to/HumanoidMocapX
# MOCAP_MODELS_DIRECTORY=/path/to/HumanoidMocapX/models
# MOCAP_DATA_DIRECTORY=/path/to/HumanoidMocapX/host
