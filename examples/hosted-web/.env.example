PORT=5081
LISTEN_HOST=127.0.0.1
# The public HTTPS address users and the editor open (an origin, no path).
PUBLIC_URL=https://mocap.example.com
# The processing host (the s&box editor host or the C# service), on a private address.
PROCESSING_URL=http://127.0.0.1:5080
# Shared with the processing host's MOCAP_KEY_SECRET. 32+ random printable characters.
MOCAP_KEY_SECRET=
# SQL database: sqlite:./mocap.db (built in), postgres://user:pass@host/db (npm install pg)
# or mysql://user:pass@host/db (npm install mysql2).
DATABASE_URL=sqlite:./mocap.db
# Largest video upload in MiB; keep it equal to the processing host's MOCAP_MAX_UPLOAD_MB.
# Roles can lower it per account (see docs/hosted-api.md, Roles).
MAX_UPLOAD_MB=512
# Starting clip limit, in seconds, of the "default" role every account has. Used only when
# the database has no default role yet; change it later with PUT /admin/roles/default.
DEFAULT_MAX_CLIP_SECONDS=60
# Optional: lets operator tools and Discord bots call /admin/*. 32+ random printable characters.
ADMIN_API_KEY=
# Optional: extra admin accounts besides the Discord server owner, comma separated.
ADMIN_ACCOUNTS=

# Sign-in providers: fill in the ones you offer. Register PUBLIC_URL/auth/callback/<name>
# (for example https://mocap.example.com/auth/callback/discord) with each provider.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Discord members must be in this server; its owner becomes an admin with priority queue.
# Discord roles in it can map to roles here (discordRoleId). Leave empty to skip.
DISCORD_GUILD_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Directory (tenant) ID; the default allows personal Microsoft accounts.
MICROSOFT_TENANT=
# Any other OpenID Connect provider: OIDC_PROVIDERS=name and OIDC_<NAME>_ISSUER/_CLIENT_ID/_CLIENT_SECRET/_LABEL.
# discord, google, microsoft, admin and host are reserved names.
OIDC_PROVIDERS=
