<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><AllowUnsafeBlocks>true</AllowUnsafeBlocks><NoWarn>$(NoWarn);CS8632</NoWarn></PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MocapRoot)/Editor/**/*.cs" Exclude="$(MocapRoot)/Editor/obj/**;$(MocapRoot)/Editor/Properties/**" />
    <ProjectReference Include="SharedCore.csproj" />
    <Reference Include="$(FACEPUNCH_ENGINE)/bin/managed/*.dll" />
    <Reference Include="$(FACEPUNCH_ENGINE)/.vs/output/Base Editor Library.dll" />
    <Using Include="Sandbox.Internal.GlobalToolsNamespace" Static="true" />
    <Using Include="Sandbox.Internal.GlobalGameNamespace" Static="true" />
  </ItemGroup>
  <Target Name="RequireEngine" BeforeTargets="ResolveReferences" Condition="'$(FACEPUNCH_ENGINE)' == ''">
    <Error Text="Set FACEPUNCH_ENGINE to the s&amp;box install containing bin/managed." />
  </Target>
</Project>
